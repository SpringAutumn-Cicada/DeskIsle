<Window x:Class="DeskIsle.DeleteConfirmation"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="删除确认" Width="420" SizeToContent="Height" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 Foreground="#EDF1F8" ShowInTaskbar="False" UseLayoutRounding="True">
<Border Background="#222936" BorderBrush="#4A566C" BorderThickness="1" CornerRadius="16" Padding="22">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="DragHeading" Background="Transparent" Margin="0,0,0,18">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="36" Height="36" CornerRadius="10" Background="#45323A" Margin="0,0,12,0">
<Path Data="M 5,7 L 19,7 M 8,7 L 8,4 L 16,4 L 16,7 M 7,7 L 8,21 L 16,21 L 17,7 M 10,10 L 10,18 M 14,10 L 14,18" Stroke="#F0A5AD" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="22" Stretch="Uniform"/>
</Border>
<TextBlock Grid.Column="1" Text="删除这个项目？" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
<Button Grid.Column="2" Content="×" IsCancel="True" Width="28" Height="28" Padding="0" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#A9B5C8" FontSize="20" ToolTip="取消删除" AutomationProperties.Name="取消删除"/>
</Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel>
<Border Background="#1B222E" BorderBrush="#354156" BorderThickness="1" CornerRadius="10" Padding="12">
<StackPanel>
<TextBlock x:Name="ItemName" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
<TextBox x:Name="ItemPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#A9B7CD" FontSize="11" Padding="0" MaxHeight="96" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="真实文件路径"/>
</StackPanel>
</Border>
<TextBlock Text="将请求 Windows 移入回收站。" TextWrapping="Wrap" FontSize="12" Foreground="#CDD5E3" Margin="0,14,0,5"/>
<TextBlock Text="若系统提示无法回收，可取消操作。只想调整分组时，可使用“移至默认卡片”。" TextWrapping="Wrap" FontSize="11" Foreground="#94A3BA"/>
</StackPanel>
</ScrollViewer>
<Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Button x:Name="CancelAction" Grid.Column="1" Content="取消" IsCancel="True" IsDefault="True" MinWidth="80" Padding="14,8" Margin="0,0,8,0"/>
<Button Grid.Column="2" Content="删除" Click="ConfirmDelete" MinWidth="80" Padding="14,8" Margin="0" Background="#75434F" BorderBrush="#AF6D7B" Foreground="#FFF0F2">
<Button.Template><ControlTemplate TargetType="Button"><Border x:Name="DangerSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DangerSurface" Property="Background" Value="#915162"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DangerSurface" Property="Background" Value="#623844"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DangerSurface" Property="BorderBrush" Value="#F6BBC6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
</Button>
</Grid>
</Grid>
</Border>
</Window>
