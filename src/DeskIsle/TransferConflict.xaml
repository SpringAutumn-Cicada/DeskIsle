<Window x:Class="DeskIsle.TransferConflict" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="同名项目" Width="470" Height="400" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="#EDF1F8" ShowInTaskbar="False" UseLayoutRounding="True">
<Border Background="#222936" BorderBrush="#4A566C" BorderThickness="1" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,14"><TextBlock x:Name="Heading" Text="目标已有同名文件" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="NameLabel" FontSize="12" Foreground="#CCD7E9" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Background="#1B222E" CornerRadius="9" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="导入项目" Foreground="#9EC8DA" FontSize="11"/><TextBlock x:Name="SourcePath" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,4"/><TextBlock x:Name="SourceMeta" Foreground="#94A3BA" FontSize="10"/></StackPanel></Border>
<Border Background="#1B222E" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="现有项目" Foreground="#E1B6A7" FontSize="11"/><TextBlock x:Name="TargetPath" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,4"/><TextBlock x:Name="TargetMeta" Foreground="#94A3BA" FontSize="10"/></StackPanel></Border>
<TextBlock x:Name="Explanation" Text="覆盖前会保留旧文件的恢复副本。跳过不改动现有文件。" FontSize="11" Foreground="#A9B7CD" TextWrapping="Wrap" Margin="0,10,0,8"/>
<CheckBox x:Name="ApplyAll" Content="对后续同类冲突应用此选择" Foreground="#C8D3E5" FontSize="11" Margin="1,3"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消本次操作" IsCancel="True" Padding="10,8" Margin="0,0,7,0"/><Button Content="跳过" IsDefault="True" Click="Skip" Padding="14,8" Margin="0,0,7,0"/><Button x:Name="ReplaceAction" Content="覆盖" Click="Replace" Padding="14,8" Margin="0" Background="#75434F" BorderBrush="#AF6D7B"/></StackPanel>
</Grid></Border></Window>
