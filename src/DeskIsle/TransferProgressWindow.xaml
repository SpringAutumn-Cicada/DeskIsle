<Window x:Class="DeskIsle.TransferProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件操作" Width="460" Height="330" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="#EDF1F8" ShowInTaskbar="False" UseLayoutRounding="True">
<Border Background="#222936" BorderBrush="#4A566C" BorderThickness="1" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="Heading" Text="正在导入到桌面" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
<StackPanel Grid.Row="1"><TextBlock x:Name="CurrentPath" TextWrapping="Wrap" Foreground="#B5C8DE" FontSize="11" MaxHeight="48"/><ProgressBar x:Name="Progress" Height="5" Margin="0,12,0,10" Minimum="0" Maximum="1" IsIndeterminate="True" Foreground="#83C9C5" Background="#303C50"/><TextBlock x:Name="Summary" Text="原件保留；同名项目会询问。" Foreground="#A9B7CD" FontSize="11" TextWrapping="Wrap"/></StackPanel>
<TextBox Grid.Row="2" x:Name="Details" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#CDB5AF" FontSize="10"/>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="恢复文件目录" Click="OpenRecovery" FontSize="11" Padding="8,7" Margin="0,0,8,0"/><Button x:Name="CancelAction" Content="取消" Click="Cancel" Padding="16,8" Margin="0" IsDefault="True"/></StackPanel>
</Grid></Border></Window>
