<Window x:Class="DeskIsle.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeskIsle" Width="320" Height="400" MinWidth="240" MinHeight="160" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Background="Transparent" Foreground="#F1F3F8">
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
<Border x:Name="Surface" Background="#D9242935" BorderBrush="#555E6A80" BorderThickness="1" CornerRadius="12" Padding="10">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="BeginDrag" MouseMove="ContinueDrag" MouseLeftButtonUp="EndDrag" LostMouseCapture="LostDrag">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="TitleText" Text="DeskIsle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
<Button Grid.Column="1" Content="退出" Click="ExitClick"/>
</Grid>
<WrapPanel Grid.Row="1"><Button Content="选择目录" Click="ChooseClick"/><Button Content="刷新" Click="RefreshClick"/><Button x:Name="ModeButton" Content="尝试桌面模式" Click="ModeClick"/></WrapPanel>
<TextBlock Grid.Row="2" x:Name="Status" Text="请选择真实目录。此版本仅展示和打开文件。" TextWrapping="Wrap" Margin="3,6" Foreground="#BDC8DC"/>
<ListBox Grid.Row="3" x:Name="Files" Background="Transparent" Foreground="#F1F3F8" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="OpenClick">
<ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" Padding="5,7"/></DataTemplate></ListBox.ItemTemplate>
<ListBox.ContextMenu><ContextMenu><MenuItem Header="打开" Click="OpenClick"/><MenuItem Header="打开所在位置" Click="RevealClick"/><MenuItem Header="刷新" Click="RefreshClick"/></ContextMenu></ListBox.ContextMenu>
</ListBox>
<StackPanel Grid.Row="4"><TextBlock x:Name="ModeText" Text="浮动模式 · Win+D 可能隐藏卡片" FontSize="11" TextWrapping="Wrap" Margin="3,4"/><DockPanel><TextBlock Text="背景" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="0.85" ValueChanged="OpacityChanged" Margin="8,4"/></DockPanel></StackPanel>
</Grid>
</Border>
</Window>
