<Window x:Class="DeskIsle.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowDrop="True" PreviewDragOver="FileDragOver" PreviewDrop="FileDrop" PreviewDragLeave="FileDragLeave" Title="DeskIsle" Width="360" Height="430" MinWidth="260" MinHeight="180" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Background="Transparent" Foreground="#F1F3F8" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
<ControlTemplate x:Key="BalancedFileScroll" TargetType="ScrollViewer">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition/><ColumnDefinition Width="7"/></Grid.ColumnDefinitions>
<ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
<ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
</Grid>
</ControlTemplate>
<Style TargetType="ScrollBar">
 <Setter Property="Width" Value="7"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
 <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#657988A3" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="AppearanceRail" TargetType="RepeatButton">
<Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="AppearanceSlider" TargetType="Slider">
<Setter Property="Height" Value="30"/><Setter Property="SmallChange" Value="0.01"/><Setter Property="LargeChange" Value="0.05"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="2,0">
<Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
<Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource AppearanceRail}" Background="#76CEC5" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
<Track.Thumb><Thumb Width="22" Height="26" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse x:Name="Ring" Width="22" Height="22" Fill="Transparent" Stroke="Transparent" StrokeThickness="2"/><Ellipse x:Name="Knob" Width="14" Height="14" Fill="#DEF7F2" Stroke="#79CFC6" StrokeThickness="1.5"/></Grid><ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#658DDCD2"/></Trigger>
<Trigger Property="IsDragging" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#A0B8F4E8"/><Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
<Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource AppearanceRail}" Background="#536279" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
</Track><Border x:Name="FocusOutline" BorderBrush="#99C8F4EB" BorderThickness="1" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
<ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Tile" TargetType="Button">
 <Setter Property="Width" Value="80"/><Setter Property="Height" Value="94"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#F1F3F8"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TileBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
 <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsReordering, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="TileBorder" Property="Background" Value="#244B6388"/></MultiDataTrigger>
 <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsReordering, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="TileBorder" Property="Background" Value="#354B6388"/><Setter TargetName="TileBorder" Property="BorderBrush" Value="#8095B5DD"/></MultiDataTrigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
</Window.Resources>
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
<AdornerDecorator>
<Border x:Name="Surface" Background="#D9242935" BorderBrush="#555E6A80" BorderThickness="1" CornerRadius="16" Padding="14">
<Border.ContextMenu><ContextMenu>
<MenuItem Header="新建"><MenuItem Header="文件夹" Tag="Folder" Click="BeginNewItemClick"/><MenuItem Header="文本文档 (.txt)" Tag="Text" Click="BeginNewItemClick"/><MenuItem Header="Markdown 文档 (.md)" Tag="Markdown" Click="BeginNewItemClick"/><Separator/><MenuItem Header="Word 文档 (.docx)" Tag="Word" Click="BeginNewItemClick"/><MenuItem Header="Excel 工作簿 (.xlsx)" Tag="Excel" Click="BeginNewItemClick"/><MenuItem Header="PDF 文档 (.pdf)" Tag="Pdf" Click="BeginNewItemClick"/><MenuItem Header="PowerPoint 演示文稿 (.pptx)" Tag="PowerPoint" Click="BeginNewItemClick"/></MenuItem>
<Separator/><MenuItem x:Name="RefreshCardMenu" Header="刷新" Click="RefreshClick"/><MenuItem x:Name="AddCardMenu" Header="添加新卡片" Click="AddCardClick"/>
</ContextMenu></Border.ContextMenu>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="BeginDrag" MouseMove="ContinueDrag" MouseLeftButtonUp="EndDrag" LostMouseCapture="LostDrag">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock x:Name="TitleText" Text="我的卡片" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="240" TextTrimming="CharacterEllipsis" Cursor="IBeam" ToolTip="点击重命名；拖动标题旁空白区域移动" MouseLeftButtonDown="RenameClick"/>
<TextBox x:Name="TitleEditor" Visibility="Collapsed" MaxLength="40" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="120" MaxWidth="240" Background="#2B3445" Foreground="#E8EFFB" CaretBrush="#A8C8FA" SelectionBrush="#638BBC" BorderBrush="#657EAA" BorderThickness="1" Padding="8,4" KeyDown="RenameKeyDown" LostKeyboardFocus="RenameLostFocus">
<TextBox.Template><ControlTemplate TargetType="TextBox"><Border x:Name="EditorBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EditorBorder" Property="BorderBrush" Value="#98B8EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></TextBox.Template>
</TextBox>
<Button Grid.Column="1" Content="•••" Width="32" Height="28" Padding="0" Click="MoreClick" Background="Transparent" Foreground="#DCE5F5" BorderThickness="0" FontSize="17" ToolTip="卡片菜单">
<Button.ContextMenu><ContextMenu>
<ContextMenu.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#202632" Offset="0"/><GradientStop Color="#1D2330" Offset="0.55"/><GradientStop Color="#202632" Offset="1"/></LinearGradientBrush></ContextMenu.Background>
<MenuItem Header="添加新卡片" Click="AddCardClick"/><MenuItem x:Name="RenameCardMenu" Header="重命名卡片" Click="RenameClick"/><MenuItem x:Name="OpenDesktopMenu" Header="打开桌面目录" Click="OpenDesktopClick"/><MenuItem x:Name="CurrentTransferMenu" Header="查看当前文件操作…" Visibility="Collapsed" Click="ViewTransferClick"/><MenuItem Header="刷新" Click="RefreshClick"/><Separator/>

<MenuItem x:Name="DefaultCardToggle" Header="设为 default 卡片" IsCheckable="True" Click="SetDefaultCardClick"/>
<MenuItem x:Name="PositionLockToggle" Header="固定卡片位置" IsCheckable="True" Click="TogglePositionLock"/>
<MenuItem x:Name="DesktopToggle" Header="隐藏桌面图标" Click="ToggleDesktopIcons"/>
<MenuItem x:Name="CardAppearanceMenu" Header="卡片外观"><MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel Width="190" Margin="0,2"><Grid Margin="0,0,0,4"><TextBlock Text="背景不透明度" Foreground="#D9E4F2" FontWeight="Medium"/><TextBlock HorizontalAlignment="Right" Foreground="#99E0D5" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}"/></Grid><Slider Style="{StaticResource AppearanceSlider}" AutomationProperties.Name="卡片背景不透明度" x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="0.85" ValueChanged="OpacityChanged"/></StackPanel></MenuItem.Header></MenuItem><MenuItem x:Name="ResetOpacityMenu" Header="恢复默认不透明度（85%）" Click="ResetCardOpacity"/></MenuItem>
<Separator/><MenuItem x:Name="RemoveCardMenu" Header="移除此卡片…" Click="RemoveCardClick"/><MenuItem x:Name="DockSettingsMenu" Header="悬浮 Dock 设置…" Click="DockSettingsClick"/><MenuItem x:Name="ExitMenu" Header="退出" Click="ExitClick"/>
</ContextMenu></Button.ContextMenu></Button>
</Grid>
<StackPanel Grid.Row="1">
<TextBlock x:Name="Status" Text="" TextWrapping="Wrap" Margin="2,6,2,0" Foreground="#AEBAD0" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
<ListBox Grid.Row="2" Margin="0,8,0,0" x:Name="Files" Background="Transparent" Foreground="#F1F3F8" BorderThickness="0" SizeChanged="GridSizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
<ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Template="{StaticResource BalancedFileScroll}" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="GridViewportChanged"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
<ListBox.Resources><Style TargetType="ListBoxItem"><EventSetter Event="RequestBringIntoView" Handler="TileBringIntoView"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources>
<ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Items}" Width="{Binding Width}" HorizontalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource Tile}" RequestBringIntoView="TileBringIntoView" PreviewMouseLeftButtonDown="TilePress" PreviewMouseLeftButtonUp="TileRelease" PreviewMouseMove="TileMove" Loaded="TileLoaded" DataContextChanged="TileContextChanged" MouseDoubleClick="OpenClick" KeyDown="TileKeyDown" PreviewMouseRightButtonDown="TileRightClick" ToolTip="{Binding FullPath}">
<Button.ContextMenu><ContextMenu><MenuItem Header="打开" Click="OpenClick"/><MenuItem Header="打开所在位置" Click="RevealClick"/><Separator/><MenuItem Header="重命名…" Click="RenameFileClick"/><MenuItem Header="复制" Tag="copy" Click="ClipboardFileClick"/><MenuItem Header="剪切" Tag="cut" Click="ClipboardFileClick"/><MenuItem Header="复制路径" Tag="path" Click="ClipboardFileClick"/><Separator/><MenuItem Header="删除…" Icon="×" Click="DeleteFileClick"/><MenuItem Header="属性" Click="FilePropertiesClick"/><MenuItem Header="移出卡片（保留原文件）" Click="RemoveReference"/><MenuItem Header="刷新" Click="RefreshClick"/></ContextMenu></Button.ContextMenu>
<Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding Placeholder}" FontSize="32" Foreground="#7FA5DC" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Width="40" Height="40"/><TextBlock Text="{Binding Availability}" FontSize="9" Foreground="#FFBFA7" VerticalAlignment="Bottom" HorizontalAlignment="Center"/><TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" VerticalAlignment="Top" Margin="0,4,0,0"/></Grid>
</Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<Border x:Name="NewItemPanel" Grid.Row="2" Panel.ZIndex="10" Visibility="Collapsed" VerticalAlignment="Stretch" Margin="0" Padding="22" Background="#222936" BorderBrush="#4A566C" BorderThickness="1" CornerRadius="12" KeyDown="NewItemKeyDown">
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock x:Name="NewItemHeading" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBox x:Name="NewItemName" MaxLength="200" FontSize="13" Padding="8,7" Background="#1D2635" Foreground="#EDF3FF" CaretBrush="#A8C8FA" BorderBrush="#6985AC" BorderThickness="1" SelectionBrush="#638BBC">
<TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></TextBox.Template>
</TextBox>
<TextBlock Text="保存位置" Foreground="#99AAC4" FontSize="11" Margin="0,12,0,4"/>
<TextBlock x:Name="NewItemLocation" FontSize="11" TextWrapping="Wrap" Foreground="#CDD8E9"/>

<TextBlock x:Name="NewItemError" Foreground="#F4B2A7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="NewItemCancel" Content="取消" Click="CancelNewItem"/><Button x:Name="NewItemCreate" Content="创建" Background="#3C6376" BorderBrush="#80B5BD" Click="CreateNewItem"/></StackPanel>
</Grid>
</Border>
</Grid>
</Border>
</AdornerDecorator>
</Window>
