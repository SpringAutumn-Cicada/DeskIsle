<Window x:Class="DeskIsle.Dock.DockBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" Title="DeskIsle Dock" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" AllowDrop="True" Drop="DropPins" PreviewDragOver="DragOverPins">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ControlStyles.xaml"/></ResourceDictionary.MergedDictionaries>
<Style x:Key="ControlKey" TargetType="Button">
<Setter Property="Width" Value="40"/><Setter Property="Height" Value="46"/><Setter Property="Foreground" Value="#B4D9ED"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Border x:Name="Glow" CornerRadius="16" Background="#196BBBD8" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="KeyLight" Width="14" Height="1.5" Background="#91DBF3" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0"/></Grid><ControlTemplate.Triggers><Trigger Property="Tag" Value="PanelOpen"><Setter TargetName="Glow" Property="Opacity" Value="1"/><Setter TargetName="KeyLight" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#C2F5FF"/><Setter TargetName="Glow" Property="Opacity" Value="1"/><Setter TargetName="KeyLight" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="TerminalKey" TargetType="Button" BasedOn="{StaticResource ControlKey}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/></Style>
</ResourceDictionary></Window.Resources>
<StackPanel x:Name="DockAssembly">
<Border x:Name="Surface" CornerRadius="22" Background="#EF202632" BorderBrush="#665D718A" BorderThickness="1" Padding="10,6" Margin="8">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".25"/></Border.Effect>
<StackPanel Orientation="Horizontal">
<Grid Width="80" Height="48" Margin="2,0" AutomationProperties.Name="当前时间">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
<TextBlock x:Name="ClockText" Text="00:00" FontFamily="Cascadia Mono, Consolas" FontSize="23" FontWeight="SemiBold" Foreground="#C2E8FA" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
<Border Grid.Row="1" Width="26" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.65"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0068BDE8" Offset="0"/><GradientStop Color="#91DBF3" Offset="0.5"/><GradientStop Color="#0068BDE8" Offset="1"/></LinearGradientBrush></Border.Background></Border>
</Grid>
<Border Width="1" Background="#506077" Margin="6,8"/>
<ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><StackPanel x:Name="Apps" Orientation="Horizontal"/></ScrollViewer>
<Border Width="1" Background="#506077" Margin="8,8"/>
<!-- One visual family, two separate click targets: desktop companion and system status. -->
<Border CornerRadius="21" Background="#092E5367" Padding="3,1" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Button Style="{StaticResource ControlKey}" Width="46" Height="46" Margin="0,0,5,0" ToolTip="显示桌面（Win+D）" AutomationProperties.Name="显示桌面" Click="ShowDesktopClick">
<Grid Width="40" Height="40">
<Border CornerRadius="14" Background="#22365B70" BorderBrush="#304F8399" BorderThickness="0.7"/>
<!-- Original asymmetric antenna, rounded visor, eyes and floating lower body. -->
<Canvas Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
<Path Data="M16,8 L16,4 L21,4" Stroke="#74D9E8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
<Ellipse Width="3" Height="3" Canvas.Left="20" Canvas.Top="2.5" Fill="#91E7EF"/>
<Path Data="M9,9 Q5,9 5,14 L5,21 Q5,25 10,25 L22,25 Q27,25 27,21 L27,14 Q27,9 23,9 Z" Fill="#183C738A" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
<Path Data="M2,16 L2,20 M30,16 L30,20" Stroke="#79C8DA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
<Path Data="M11,15 L11,18 M21,15 L21,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
<Path Data="M14,21 Q16,22 18,21 M12,28 L20,28" Stroke="#74D9E8" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
</Canvas>
</Grid></Button>
<Button x:Name="StatusKey" Style="{StaticResource ControlKey}" Width="112" ToolTip="网络、蓝牙与音量控制" AutomationProperties.Name="打开控制中心" Click="QuickSettingsClick">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Grid x:Name="NetworkKey" Width="28" Height="28" Margin="0,0,6,0"><Path StrokeLineJoin="Round" x:Name="NetworkGlyph" Data="M1,7 Q12,-2 23,7 M5,12 Q12,5 19,12 M9,17 Q12,14 15,17 M12,21 L12,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform"/></Grid>
<Grid x:Name="AudioKey" Width="28" Height="28" Margin="0,0,6,0"><Path StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" x:Name="AudioGlyph" Data="M2,8 L7,8 L13,3 L13,21 L7,16 L2,16 Z M17,7 Q23,12 17,17 M20,3 Q30,12 20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="34" Height="24" Stretch="None"><Path.LayoutTransform><ScaleTransform ScaleX="0.70" ScaleY="0.70"/></Path.LayoutTransform></Path></Grid>
<Grid x:Name="BatteryKey" Width="34" Height="28">
<Viewbox Width="28" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"><Grid Width="32" Height="20">
<Path x:Name="BatteryGlyph" Data="M5,2 L23,2 Q27,2 27,6 L27,14 Q27,18 23,18 L5,18 Q1,18 1,14 L1,6 Q1,2 5,2 Z M28,7 Q31,7 31,9 L31,11 Q31,13 28,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
<TextBlock x:Name="BatteryText" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Grid></Viewbox>
<Path x:Name="ChargingGlyph" Data="M5,0 L1,6 L5,6 L1,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="5" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
</Grid>
</StackPanel></Button>
</StackPanel></Border>
</StackPanel></Border></StackPanel></Window>
