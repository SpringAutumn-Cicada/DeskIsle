<Window x:Class="DeskIsle.Dock.DockBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" Title="DeskIsle Dock" AllowDrop="True" Drop="DropPins" PreviewDragOver="DragOverPins">
<Border x:Name="Surface" CornerRadius="22" Background="#EF202632" BorderBrush="#665D718A" BorderThickness="1" Padding="10,6" Margin="8">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".25"/></Border.Effect>
<StackPanel Orientation="Horizontal">
<ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Apps" Orientation="Horizontal"/></ScrollViewer>
<Border Width="1" Background="#506077" Margin="8,8"/>
<Button Content="▤" FontSize="24" Width="46" Height="48" Padding="0" ToolTip="显示原生任务栏" Click="NativeClick"/>
<Button Content="⚙" FontSize="20" Width="40" Height="48" Padding="0" ToolTip="Dock 设置" Click="SettingsClick"/>
</StackPanel></Border></Window>
