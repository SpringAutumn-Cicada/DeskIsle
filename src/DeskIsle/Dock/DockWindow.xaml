<Window x:Class="DeskIsle.Dock.DockBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight" Title="DeskIsle Dock" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" AllowDrop="True" Drop="DropPins" PreviewDragOver="DragOverPins">
<Window.Resources>
<Style x:Key="ControlKey" TargetType="Button">
<Setter Property="Width" Value="40"/><Setter Property="Height" Value="46"/><Setter Property="Foreground" Value="#B4D9ED"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Border x:Name="Glow" CornerRadius="16" Background="#196BBBD8" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="KeyLight" Width="14" Height="1.5" Background="#91DBF3" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#C2F5FF"/><Setter TargetName="Glow" Property="Opacity" Value="1"/><Setter TargetName="KeyLight" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
</Window.Resources>
<StackPanel x:Name="DockAssembly"><Grid HorizontalAlignment="Center" Margin="8,8,8,4">
<Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="12"/></Grid.RowDefinitions>
<Border x:Name="TerminalSurface" CornerRadius="12" Background="#F0202632" BorderBrush="#8899C8DD" BorderThickness="1" Padding="12,4">
<Border.Effect><DropShadowEffect Color="#4EA5BF" BlurRadius="10" ShadowDepth="1" Opacity="0.18"/></Border.Effect>
<Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ControlKey}" ToolTip="显示原生任务栏" Click="NativeClick"><Path Data="M2,3 L22,3 L22,21 L2,21 Z M2,9 L22,9 M5,6 L6,6 M9,6 L10,6 M13,6 L14,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="23" Height="23" Stretch="Uniform"/></Button><Button Style="{StaticResource ControlKey}" ToolTip="任务管理器" AutomationProperties.Name="打开任务管理器" Click="TaskManagerClick"><Path Data="M2,3 L22,3 L22,21 L2,21 Z M5,14 L8,14 L10,8 L13,17 L16,11 L19,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="23" Height="23" Stretch="Uniform"/></Button><Button Style="{StaticResource ControlKey}" ToolTip="Dock 设置" Click="SettingsClick"><Path Data="M4,2 L4,22 M12,2 L12,22 M20,2 L20,22 M1,7 L7,7 M9,16 L15,16 M17,9 L23,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="23" Height="23" Stretch="Uniform"/></Button><Border Width="1" Height="30" Background="#506077" Margin="8,0"/>
<Button x:Name="BackgroundKey" Style="{StaticResource ControlKey}" ToolTip="后台应用与原生托盘" Click="BackgroundClick"><Path Data="M2,15 L12,5 L22,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="23" Height="18" Stretch="Uniform"/></Button>
<Button x:Name="NetworkKey" Style="{StaticResource ControlKey}" ToolTip="网络状态" Click="NetworkClick"><Path x:Name="NetworkGlyph" Data="M1,7 Q12,-2 23,7 M5,12 Q12,5 19,12 M9,17 Q12,14 15,17 M12,21 L12,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="25" Height="23" Stretch="Uniform"/></Button>
<Button x:Name="AudioKey" Style="{StaticResource ControlKey}" ToolTip="音量" Click="AudioClick"><Path x:Name="AudioGlyph" Data="M2,8 L7,8 L13,3 L13,21 L7,16 L2,16 Z M17,7 Q23,12 17,17 M20,3 Q30,12 20,21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="26" Height="23" Stretch="Uniform"/></Button>
<Button x:Name="BatteryKey" Style="{StaticResource ControlKey}" Width="82" ToolTip="电池" Click="BatteryClick"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="BatteryGlyph" Data="M1,5 L21,5 L21,19 L1,19 Z M21,9 L24,9 L24,15 L21,15 M12,7 L8,13 L14,13 L10,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="26" Height="20" Stretch="Uniform"/><TextBlock x:Name="BatteryText" FontFamily="Cascadia Mono, Consolas" FontSize="15" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
</StackPanel><Ellipse Width="4" Height="4" Fill="#55DDEB" HorizontalAlignment="Right" VerticalAlignment="Top"/><Border Height="1" Width="76" Background="#66D8ED" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="38,0,0,0"/><Border Height="1" Width="76" Background="#66D8ED" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,0"/></Grid></Border>
<Grid Grid.Row="1" Width="100"><Path Data="M40,0 L60,0 L63,9 L37,9 Z" Fill="#DB283B48"/><Border Height="3" VerticalAlignment="Bottom" CornerRadius="2" Background="#5D8297" BorderBrush="#99AFD5E6" BorderThickness="0.5"/></Grid>
</Grid>
<Border x:Name="Surface" CornerRadius="22" Background="#EF202632" BorderBrush="#665D718A" BorderThickness="1" Padding="10,6" Margin="8">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".25"/></Border.Effect>
<StackPanel Orientation="Horizontal">
<Grid Width="80" Height="48" Margin="2,0" AutomationProperties.Name="当前时间">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
<TextBlock x:Name="ClockText" Text="00:00" FontFamily="Cascadia Mono, Consolas" FontSize="23" FontWeight="SemiBold" Foreground="#C2E8FA" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
<Border Grid.Row="1" Width="26" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.65"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0068BDE8" Offset="0"/><GradientStop Color="#91DBF3" Offset="0.5"/><GradientStop Color="#0068BDE8" Offset="1"/></LinearGradientBrush></Border.Background></Border>
</Grid>
<Border Width="1" Background="#506077" Margin="6,8"/>
<ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><StackPanel x:Name="Apps" Orientation="Horizontal"/></ScrollViewer>
<Border Width="1" Background="#506077" Margin="8,8"/>
<Button Style="{StaticResource ControlKey}" Width="54" Height="52" ToolTip="显示桌面（Win+D）" AutomationProperties.Name="显示桌面" Click="ShowDesktopClick"><Grid Width="48" Height="46"><Border CornerRadius="15" Background="#18386677" BorderBrush="#6075BED9" BorderThickness="1"/><Path Data="M8,14 L8,8 L16,8 M32,38 L40,38 L40,32" Stroke="#6CE5ED" StrokeThickness="1.2"/><Path Data="M2,3 L22,3 L22,17 L2,17 Z M12,17 L12,22 M7,22 L17,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="23" Height="23" Stretch="Uniform"/></Grid></Button>
</StackPanel></Border></StackPanel></Window>
