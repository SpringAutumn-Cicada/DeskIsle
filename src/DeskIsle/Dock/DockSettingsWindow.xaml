<Window x:Class="DeskIsle.Dock.DockSettingsWindow" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dock 设置" Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="#EAF0F8" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
<Style x:Key="Switch" TargetType="CheckBox">
<Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
<Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="#485365"><Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#F1F5FA" HorizontalAlignment="Left" Margin="3"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#65BDB3"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#C4F8EF"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="RailButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Slider"><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
<Grid Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
<Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource RailButton}" Command="Slider.DecreaseLarge" Background="#71C9BE"/></Track.DecreaseRepeatButton>
<Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="8" Background="#D6F3ED" BorderBrush="#78C6BD" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
<Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource RailButton}" Command="Slider.IncreaseLarge" Background="#39465B"/></Track.IncreaseRepeatButton>
</Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="SettingCard" TargetType="Border"><Setter Property="Background" Value="#202A38"/><Setter Property="BorderBrush" Value="#344254"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
</Window.Resources>
<Border Background="#19212D" BorderBrush="#47566C" BorderThickness="1" CornerRadius="18" Padding="24">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Background="Transparent" MouseLeftButtonDown="DragHeading" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Dock 设置" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="你的桌面，轻盈有序" Foreground="#91A1B7" FontSize="12" Margin="0,5,0,0"/></StackPanel>
<Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0" FontSize="20" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ToolTip="关闭设置" Click="CancelClick"/>
</Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource SettingCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="悬浮应用栏" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="启动时自动开启；此开关控制本次运行" Foreground="#93A4BC" FontSize="11" Margin="0,5,10,0"/></StackPanel><CheckBox x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="启用悬浮 Dock"/></Grid></Border>
<Border Style="{StaticResource SettingCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录后立即启动" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="跟随当前程序位置；关闭后恢复原有自启方式" Foreground="#93A4BC" FontSize="11" Margin="0,5,10,0"/></StackPanel><CheckBox x:Name="LoginToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="登录后立即启动"/></Grid></Border>
<Border Style="{StaticResource SettingCard}"><StackPanel>
<Grid><TextBlock Text="唤出等待" FontSize="12"/><TextBlock x:Name="RevealValue" HorizontalAlignment="Right" Foreground="#8DD9CE" FontSize="12"/></Grid>
<Slider x:Name="RevealSlider" Minimum="0" Maximum="1000" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ValuesChanged" AutomationProperties.Name="唤出等待毫秒"/>
<Grid Margin="0,8,0,0"><TextBlock Text="移开后收起" FontSize="12"/><TextBlock x:Name="HideValue" HorizontalAlignment="Right" Foreground="#8DD9CE" FontSize="12"/></Grid>
<Slider x:Name="HideSlider" Minimum="200" Maximum="3000" SmallChange="50" LargeChange="100" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="ValuesChanged" AutomationProperties.Name="收起等待毫秒"/>
</StackPanel></Border>
<Border Style="{StaticResource SettingCard}"><StackPanel><Grid><TextBlock Text="背景不透明度" FontSize="12"/><TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="#8DD9CE" FontSize="12"/></Grid><Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="ValuesChanged" AutomationProperties.Name="背景不透明度"/></StackPanel></Border>
<Border Style="{StaticResource SettingCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="任务栏切换快捷键" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Ctrl + Alt +" Foreground="#A3B2C7" VerticalAlignment="Center" Margin="0,0,10,0"/>
<TextBox x:Name="HotKeyEditor" Grid.Column="2" MaxLength="1" CharacterCasing="Upper" TextAlignment="Center" FontSize="14" Padding="6" Foreground="#D8F2ED" Background="#15212C" BorderBrush="#527468" ToolTip="输入 A 到 Z 的一个字母" AutomationProperties.Name="切换快捷键字母"/>
</Grid></Border>
<TextBlock x:Name="ErrorText" Foreground="#ECA6AD" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
</StackPanel></ScrollViewer>
<Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Content="取消" MinWidth="70" Click="CancelClick"/><Button Grid.Column="2" Content="保存" MinWidth="70" Background="#35665E" BorderBrush="#6ABAAE" IsDefault="True" Click="SaveClick"/></Grid>
</Grid></Border></Window>
