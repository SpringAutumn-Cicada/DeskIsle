<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="PanelAction" TargetType="Button">
<Setter Property="Foreground" Value="#D6E4ED"/><Setter Property="Background" Value="#25323E"/><Setter Property="BorderBrush" Value="#294F687D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="38"/><Setter Property="Focusable" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Grid><Border x:Name="Frame" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/><Border x:Name="Hover" CornerRadius="14" Background="#1596D7F4" Opacity="0" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="Focus" CornerRadius="14" BorderBrush="#94D3EA" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
<ControlTemplate.Triggers>
<Trigger Property="Tag" Value="RadioLeft"><Setter TargetName="Frame" Property="CornerRadius" Value="14,0,0,14"/><Setter TargetName="Hover" Property="CornerRadius" Value="14,0,0,14"/></Trigger>
<Trigger Property="Tag" Value="RadioRight"><Setter TargetName="Frame" Property="CornerRadius" Value="0,14,14,0"/><Setter TargetName="Hover" Property="CornerRadius" Value="0,14,14,0"/></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="PanelTool" TargetType="Button" BasedOn="{StaticResource PanelAction}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,5"/></Style>
<Style x:Key="PanelCompactTool" TargetType="Button" BasedOn="{StaticResource PanelAction}">
<Setter Property="Width" Value="44"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="BorderBrush" Value="#887A909F"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
</Style>
<Style x:Key="PanelListAction" TargetType="Button" BasedOn="{StaticResource PanelAction}"><Setter Property="Background" Value="#252D35"/><Setter Property="BorderBrush" Value="#40596A79"/><Setter Property="BorderThickness" Value="0.7"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,3"/></Style>
<Style x:Key="SoftScrollButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="SoftScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SoftScrollButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SoftScrollButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Width="4" CornerRadius="2" Background="#607D92" Margin="2,1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A5CADC"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A5CADC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="VolumeTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="PanelVolumeSlider" TargetType="Slider">
<Setter Property="Height" Value="32"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="0,3"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="False">
<Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource VolumeTrackButton}" Command="Slider.DecreaseLarge" Background="#68CCE9"/></Track.DecreaseRepeatButton>
<Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource VolumeTrackButton}" Command="Slider.IncreaseLarge" Background="#465565"/></Track.IncreaseRepeatButton>
<Track.Thumb><Thumb Width="24" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent" Width="24" Height="24"><Ellipse Width="13" Height="13" Fill="#DAF4FF" Stroke="#72CBE7" StrokeThickness="2" VerticalAlignment="Center"/><Ellipse x:Name="Ring" Width="19" Height="19" Stroke="#5289CDE5" StrokeThickness="2" VerticalAlignment="Center" Opacity="0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
</Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary>
